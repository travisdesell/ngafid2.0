#!/bin/bash

# Backfill min_latitude, max_latitude, min_longitude, max_longitude on the events table
# for existing events that have NULL bbox. Required so older events show on the heatmap
# (proximity_events_in_box filters by these columns).
#
# Run from repo root: ./run/backfill/backfill_event_bbox [--batch N] [--limit N]
#
# Do NOT redirect to the repo (e.g. > backfill.log). Log goes to /tmp with a 100MB cap.

JAR_PATH="ngafid-core/target/ngafid-core-1.0-SNAPSHOT-jar-with-dependencies.jar"

if [ ! -f "$JAR_PATH" ]; then
    echo "Error: JAR file not found at $JAR_PATH"
    echo "Please build the project first: mvn clean package"
    exit 1
fi

LOG_DIR="${NGAFID_BACKFILL_LOG_DIR:-/tmp/ngafid-backfill-logs}"
LOG_FILE="$LOG_DIR/backfill_event_bbox.log"
MAX_BYTES="${NGAFID_BACKFILL_LOG_MAX_BYTES:-104857600}"
mkdir -p "$LOG_DIR"
: >"$LOG_FILE"
echo "Backfill log: $LOG_FILE (cap ${MAX_BYTES} bytes/run)"

written=0
capped=0
set -o pipefail
java -cp "$JAR_PATH" org.ngafid.core.heatmap.BackfillEventBbox "$@" 2>&1 | while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
    if [ "$capped" -eq 0 ]; then
        n=$((${#line} + 1))
        if [ $((written + n)) -le "$MAX_BYTES" ]; then
            printf '%s\n' "$line" >>"$LOG_FILE"
            written=$((written + n))
        else
            echo "[log capped at ${MAX_BYTES} bytes; further output stdout only]" >>"$LOG_FILE"
            capped=1
        fi
    fi
done
exit "${PIPESTATUS[0]}"
