# ngafid-base is a locally-built image (see the root Dockerfile), not a registry
# image, so there is no published version tag to pin.
# hadolint ignore=DL3006
FROM ngafid-base
#Note: This directory is already created in the Dockerfile at the project root
RUN mkdir -p /opt/ngafid-core
COPY ngafid-core/target/ngafid-core-1.0-SNAPSHOT-jar-with-dependencies.jar /opt/ngafid-core/ngafid-core.jar
CMD ["java", "-cp", "/opt/ngafid-core/ngafid-core.jar", "org.ngafid.core.kafka.Topic"]