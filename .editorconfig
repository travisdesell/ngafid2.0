# EditorConfig -- https://editorconfig.org
#
# Scoped to Kotlin so it configures ktlint (run via Spotless and the lint
# inventory) without changing editor behavior for other file types. Keep the
# max line length aligned with the Java Checkstyle LineLength (120).
root = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
# Allow wildcard imports, consistent with the Java side (Checkstyle's AvoidStarImport
# is off) and the idiomatic Javalin routing DSL import `io.javalin.apibuilder.ApiBuilder.*`.
ktlint_standard_no-wildcard-imports = disabled
max_line_length = 120
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
